# Source-control and local Python state
.git/
.github/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.test-tmp*/
tests/

# Secrets and machine-local configuration
.env*
secrets/
deploy/secrets/
*.secret
*.pem
*.key

# Untrusted or generated data must never enter a Docker build context
data/
artifacts/
models/
reports/
reports/generated/
runs/
server-results/
*.pkl
*.pickle
*.joblib
*.pt
*.pth

# Frontend and packaging outputs
node_modules/
frontend/node_modules/
frontend/.next/
frontend/tests/
build/
dist/
coverage/
*.log
