# Public release identities. Copy to a server-only .env file and fill locally.
ACR_REGISTRY=
ACR_NAMESPACE=
RELEASE_TAG=
PUBLIC_ORIGIN=

# Optional audited Feishu/Aily bundle. These are used only with the reviewed override.
FEISHU_APP_ID=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
FEISHU_ENGINEERING_RULESETS_FILE=
FEISHU_ENGINEERING_RULESETS_SHA256=
FEISHU_RECHECK_TABLE_ID=
FEISHU_RECHECK_PERMISSION_REFERENCE=
EXTERNAL_HTTPS_BASE_URL=
ALLOW_CANDIDATE_SCENARIO_EXECUTION=
ALLOW_CANDIDATE_SCENARIO_RESULTS=
AILY_MCP_ALLOWED_SOURCE_IPS=

# SHA-verified Advanced deployment registry.
DEPLOYMENT_REGISTRY_ID=
DEPLOYMENT_REGISTRY_ROOT=
CALIBRATION_EVIDENCE_ROOT=

# Operator-owned host directories.
QUANXIN_SECRETS_ROOT=
DATA_ROOT=
ARTIFACT_ROOT=
POLICY_ROOT=
CONFIG_ROOT=
POSTGRES_DATA_ROOT=
REDIS_DATA_ROOT=
LETSENCRYPT_ROOT=
ACME_WEBROOT=
